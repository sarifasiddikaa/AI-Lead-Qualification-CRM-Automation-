                    "result": {
                        "valid": true,
                        "fields": []
                    }
                },
                "restore": {
                    "parameters": {
                        "__IMTCONN__": {
                            "label": "Sarifa's Google connection (sarifasiddikaa@gmail.com)",
                            "data": {
                                "scoped": "true",
                                "connection": "google"
                            }
                        },
                        "spreadsheetId": {
                            "mode": "chose",
                            "label": "Lead Qualification CRM"
                        },
                        "valueRenderOption": {
                            "mode": "chose",
                            "label": "Formatted value"
                        },
