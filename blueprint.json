        {
            "id": 2,
            "module": "openai-gpt-3:askAnything",
            "version": 1,
            "parameters": {},
            "mapper": {
                "model": "gpt-5-nano",
                "textPrompt": "A sales lead submitted this inquiry to a training company.\nName: {{1.`1`}}\nCompany: {{1.`3`}}\nJob Title: {{1.`4`}}\nBudget: {{1.`5`}}\nMessage: {{1.`6`}}\n\nRespond ONLY with valid JSON, no extra text, no markdown, in exactly this format:\n{\"summary\": \"one sentence summary of the inquiry\", \"intent\": \"what the lead wants\", \"lead_score\": 7, \"next_action\": \"recommended next step\"}\n\nSet lead_score as an integer from 1 to 10 based on how qualified and ready-to-buy this lead seems, considering budget and urgency in the message."
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 450
                }
            },
            "onerror": [
                {
                    "id": 9,
                    "module": "builtin:Resume",
                    "version": 1,
                    "parameters": {},
                    "mapper": {
                        "result": "{\"summary\": \"AI analysis failed\", \"intent\": \"unknown\", \"lead_score\": 0, \"next_action\": \"Manual review required\"}"
                    },
                    "metadata": {
                        "designer": {
                            "x": 600,
                            "y": 900
                        }
                    }
                }
            ]
        },
        {
            "id": 3,
            "module": "json:ParseJSON",
            "version": 1,
            "parameters": {
                "type": 611194
            },
            "mapper": {
                "json": "{{2.result}}"
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 300
                }
            }
        },
        {
            "id": 4,
            "module": "builtin:BasicRouter",
            "version": 1,
            "parameters": {},
            "mapper": null,
            "metadata": {
                "designer": {
                    "x": 900,
                    "y": 300
                }
            },
            "routes": [
                {
                    "flow": [
                        {
                            "id": 5,
                            "module": "email:ActionSendMeEmail",
                            "version": 7,
                            "parameters": {},
                            "filter": {
                                "name": "High-quality lead",
                                "conditions": [
                                    [
                                        {
                                            "a": "{{3.lead_score}}",
                                            "b": "8",
                                            "o": "number:greaterorequal"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "to": "sarifasiddikaa@gmail.com",
                                "html": "Company: {{1.`3`}}<br>Job Title: {{1.`4`}}<br>Budget: {{1.`5`}}<br>Message: {{1.`6`}}<br><br>Summary: {{3.summary}}<br>Intent: {{3.intent}}<br>Score: {{3.lead_score}}<br>Next Action: {{3.next_action}}",
                                "subject": "High-Quality Lead: {{1.`1`}}"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 1200,
                                    "y": 0
                                }
                            }
                        },
